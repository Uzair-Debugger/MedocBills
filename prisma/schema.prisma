generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEW
  ACCEPTED
  REJECTED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

model admin {
  id         Int        @id @default(autoincrement())
  name       String
  email      String     @unique
  password   String

  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  job_posts  job_post[]
}

model job_post {
  id           Int           @id @default(autoincrement())
  admin_id     Int

  title        String
  description  String
  location     String
  salary       Decimal       @db.Decimal(12, 2)
  company_name String
  status       JobStatus     @default(OPEN)

  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  admin        admin         @relation(fields: [admin_id], references: [id])
  applications application[]

  @@index([admin_id])
}

model application {
  id              Int               @id @default(autoincrement())
  job_post_id     Int

  applicant_name  String
  applicant_email String
  resume_url      String
  coverletter_url String?
  status          ApplicationStatus @default(PENDING)

  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  job_post        job_post          @relation(fields: [job_post_id], references: [id])

  @@index([job_post_id])
}