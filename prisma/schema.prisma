generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEW
  SELECTED
  NOT_SELECTED
  WITHDRAWN
  ACCEPTED
  REJECTED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED
}

model admin {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  job_posts     job_post[]
  email_history email_history[]
}

model job_post {
  id       Int @id @default(autoincrement())
  admin_id Int

  title        String
  description  String
  location     String
  salary       Decimal   @db.Decimal(12, 2)
  company_name String
  last_date    DateTime?
  status       JobStatus @default(OPEN)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  admin         admin           @relation(fields: [admin_id], references: [id])
  applications  application[]
  email_history email_history[]

  @@index([admin_id])
}

model application {
  id          Int @id @default(autoincrement())
  job_post_id Int

  applicant_name  String
  applicant_email String
  applicant_phone String
  resume_url      String
  coverletter_url String?
  status          ApplicationStatus @default(PENDING)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  job_post      job_post        @relation(fields: [job_post_id], references: [id])
  email_history email_history[]

  @@index([job_post_id])
}

model email_history {
  id             Int         @id @default(autoincrement())
  admin_id       Int?
  application_id Int?
  recipient      String
  subject        String
  template       String
  status         EmailStatus
  error_message  String?
  sent_at        DateTime?
  created_at     DateTime    @default(now())

  admin       admin?       @relation(fields: [admin_id], references: [id], onDelete: SetNull)
  application application? @relation(fields: [application_id], references: [id], onDelete: SetNull)
  jobPost     job_post?    @relation(fields: [job_postId], references: [id])
  job_postId  Int?

  @@index([admin_id, created_at])
  @@index([application_id, created_at])
}
